programa {
    inclua biblioteca Matematica --> mat
    funcao inicio() {

        real numero
         escreva("Digite um numero: ")
         leia(numero)

         escreva("\nValor arredondado: ", mat.arredondar(numero, 0))
          escreva("\nRaiz quadrada: ", mat.raiz(numero, 2))
           escreva("\nValor ao quadrado: ", mat.potencia(numero, 2))
    }
}
